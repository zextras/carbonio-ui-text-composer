{
	"name": "@zextras/carbonio-ui-text-composer",
	"version": "0.0.0-semantically-released",
	"description": "Carbonio UI Text Composer Library",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"README.md",
		"dist",
		"COPYING",
		"LICENSE",
		"THIRDPARTIES",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"prettify": "prettier --check --write .",
		"prettify:check": "prettier --check .",
		"prettify:check:stagedFiles": "prettier --check $(git --no-pager diff --name-only --cached | tr '\\n' ' ')",
		"prepack": "npm run build",
		"prepare": "is-ci || husky",
		"type-check": "tsc --noEmit",
		"packTo": "npm pack --pack-destination $PKG_PATH && cd $PKG_PATH && npm i zextras-carbonio-ui-text-composer-$npm_package_version.tgz",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zextras/carbonio-ui-text-composer.git"
	},
	"author": "Zextras Dev Team <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@tinymce/tinymce-react": "^4.3.2",
		"date-fns": "^4.1.0",
		"tinymce": "^6.8.4"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.5.2",
		"@tinymce/tinymce-react": "^4.3.2",
		"@types/node": "^22.10.2",
		"@types/react": "^18.3.7",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^5.0.4",
		"@vitest/coverage-v8": "^3.1.1",
		"@zextras/carbonio-design-system": "^11.0.0-devel.1",
		"@zextras/carbonio-ui-configs": "^2.1.0",
		"babel-plugin-transform-react-remove-prop-types": "^0.4.24",
		"eslint-plugin-notice": "^1.0.0",
		"husky": "^9.1.7",
		"i18next": "^22.4.13",
		"is-ci": "^4.1.0",
		"jsdom": "^27.0.0",
		"react-i18next": "^12.2.0",
		"sonar-scanner": "^3.1.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.9",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@zextras/carbonio-design-system": "^11.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^12.0.0"
	}
}
